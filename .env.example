# Copia este archivo como ".env" y ajusta los valores.
# El archivo ".env" NO se sube al repositorio.

# --- Base de datos ---
DB_NAME=pasantias
DB_USER=pasantias_user
DB_PASSWORD=cambiar_esta_clave

# --- Seguridad ---
# Cadena larga y aleatoria (minimo 32 caracteres)
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRACION_MINUTOS=60

# --- Almacenamiento de archivos ---
STORAGE_PATH=/data/archivos
MAX_ARCHIVO_MB=10

# --- Correo (en desarrollo se usa Mailpit) ---
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_REMITENTE=pasantias.fq@uce.edu.ec

# --- General ---
TZ=America/Guayaquil
APP_URL=http://localhost
